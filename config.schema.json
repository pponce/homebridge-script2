      "Stateless Switches": {
        "title": "Stateless Switches",
        "type": "array",
        "description": "Recommended: configure one-shot trigger devices here.",
        "items": {
          "title": "{{ value.name || \"New Stateless Trigger\" }}",
          "type": "object",
          "properties": {
            "name": {
              "title": "Accessory Name",
              "type": "string",
