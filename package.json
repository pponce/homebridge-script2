{
  "name": "homebridge-script2",
  "version": "1.0.2",
  "license": "MIT",
  "description": "HomeKit script switches with file or command state, shared reads, serialized actions and optional early acknowledgement",
  "keywords": [
    "homebridge-plugin",
    "homebridge-script2",
    "supports-hap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pponce/homebridge-script2.git"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-source.js",
    "test:ui": "node --test test/ui.browser.cjs",
    "check:package": "node scripts/check-package.js",
    "prepublishOnly": "npm run check && npm test",
    "test:installed": "node --test test/installed.cjs"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.6",
    "chokidar": "5.0.0"
  },
  "displayName": "Script2",
  "main": "index.js",
  "homepage": "https://github.com/pponce/homebridge-script2#readme",
  "bugs": {
    "url": "https://github.com/pponce/homebridge-script2/issues"
  },
  "files": [
    "index.js",
    "lib",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE",
    "assets/homebridge-script2-icon.png",
    "assets/homebridge-script2-icon-512.png"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "readdirp": "5.0.0"
  },
  "devDependencies": {
    "ajv": "8.17.1"
  }
}
